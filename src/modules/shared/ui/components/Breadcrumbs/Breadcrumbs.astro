---
import { t } from '@/i18n';
import { ROUTES } from '@/routes';
import './Breadcrumbs.scss';

interface BreadcrumbItem {
  label: string;
  path?: string;
}

interface Props {
  currentLabel?: string;
  // W server island Astro.url wskazuje na endpoint wyspy, dlatego ścieżkę strony podaje rodzic
  path?: string;
}

const { currentLabel, path = Astro.url.pathname } = Astro.props;

const items: BreadcrumbItem[] = [{ label: t('nav.home'), path: ROUTES.HOME.path }];

const segments = path.split('/').filter((segment) => segment !== '');
let currentPath = '';

segments.forEach((segment, index) => {
  currentPath += `/${segment}`;
  const isLast = index === segments.length - 1;

  let label: string | undefined;

  // Map route paths to translation keys
  if (currentPath === ROUTES.PRODUCTS.path) {
    label = t('nav.products');
  }

  if (isLast && currentLabel) {
    label = currentLabel;
  }

  if (!label) {
    label = segment;
  }

  items.push({
    label,
    path: isLast ? undefined : currentPath,
  });
});
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ul class="breadcrumbs__list">
    {
      items.map((item, index) => (
        <li class="breadcrumbs__item">
          {item.path ? (
            <a href={item.path} class="breadcrumbs__link">
              {item.label}
            </a>
          ) : (
            <span class="breadcrumbs__current" aria-current="page">
              {item.label}
            </span>
          )}
          {index < items.length - 1 && (
            <span class="breadcrumbs__separator" aria-hidden="true">
              {' \u203A '}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>
