---
import Header from '@/modules/shared/ui/components/Header/Header.astro';
import Footer from '@/modules/shared/ui/components/Footer/Footer.astro';
import { t } from '@/i18n';
import '@/styles/globals.scss';
import '@/styles/layout.scss';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t('meta.description')} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
    <title>{t('meta.title')}</title>
  </head>
  <body>
    <div id="app">
      <div class="layout">
        <Header />
        <main class="layout__container">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
